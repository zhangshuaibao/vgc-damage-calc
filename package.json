{
  "name": "vgc_calc_react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.7",
    "react-confirm": "^0.5.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.16.0",
    "react-scripts": "^5.0.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "REACT_APP_VERSION=dev craco start",
    "api:build": "tsc -p api/tsconfig.json",
    "api": "node dist/api/calc-server.js",
    "build": "REACT_APP_VERSION=$(date +%Y%m%d%H%M%S) GENERATE_SOURCEMAP=false PUBLIC_URL=/calc craco build",
    "test": "REACT_APP_VERSION=test craco test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "src/vendors/**/*",
      "src/vendors/**",
      "**/vendors/**",
      "vendors/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
